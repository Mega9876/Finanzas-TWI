# Configuración de ejemplo: completar SOLO en .env local (ignorado por Git).
# DotNetEnv busca .env desde el directorio actual hacia arriba y no sobrescribe
# variables ya exportadas. No subir secretos ni compartirlos por chat.
ConnectionStrings__DefaultConnection='Host=localhost;Port=5432;Database=finanzas_db;Username=postgres;Password=CAMBIAR_LOCALMENTE'

Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Google__CallbackPath=/api/auth/google/callback

Authentication__Discord__ClientId=
Authentication__Discord__ClientSecret=
Authentication__Discord__CallbackPath=/api/auth/discord/callback

Authentication__Twitch__ClientId=
Authentication__Twitch__ClientSecret=
Authentication__Twitch__CallbackPath=/signin-twitch

Authentication__Spotify__ClientId=
Authentication__Spotify__ClientSecret=
Authentication__Spotify__CallbackPath=/signin-spotify

Authentication__Dropbox__ClientId=
Authentication__Dropbox__ClientSecret=
Authentication__Dropbox__CallbackPath=/auth/dropbox/callback

Authentication__Microsoft__ClientId=
Authentication__Microsoft__ClientSecret=
Authentication__Microsoft__TenantId=common
Authentication__Microsoft__CallbackPath=/auth/microsoft/callback

# Compatibilidad: se siguen aceptando Auth__Twitch__..., AUTH__TWITCH__...
# y equivalentes de Spotify; preferir las claves Authentication__... anteriores.
# Authentication__Google__RedirectUri y Authentication__Discord__RedirectUri
# antiguos siguen aportando la ruta cuando falta CallbackPath. El origen se
# obtiene de la petición HTTPS real, no se fuerza el puerto de la URI antigua.
